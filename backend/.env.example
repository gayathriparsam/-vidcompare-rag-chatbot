# OpenAI (mandatory for embeddings + chat)
OPENAI_API_KEY=sk-...

# Optional: override defaults
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# CHROMA_PERSIST_DIR=./.chroma
# CHROMA_COLLECTION=video_rag

# --- Optional fallbacks -----------------------------------------------------
# Path to a Netscape-format cookies.txt for Instagram scraping. Required in
# 2025 because IG blocks anonymous GraphQL calls. Export from your browser
# with a "Get cookies.txt LOCALLY" extension after logging into instagram.com.
# IG_COOKIE_FILE=./ig_cookies.txt

# Manual overrides (JSON files) for cases where scraping is blocked. Each
# file must contain {"meta": {...}, "transcript": "..."} and matches the
# VideoMetadata schema in app/schemas/models.py. Useful for demos and CI.
# MANUAL_A_JSON=./sample_data/video_a.json
# MANUAL_B_JSON=./sample_data/video_b.json
