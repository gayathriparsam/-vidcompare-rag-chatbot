# OpenAI — leave empty to run the WHOLE app locally (no quota, no cost).
# The app uses local embeddings + extractive QA fallback when this is empty.
OPENAI_API_KEY=

# Optional: override defaults
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# CHROMA_PERSIST_DIR=./.chroma
# CHROMA_COLLECTION=video_rag

# Force local mode even if a key is set (e.g. when quota is exhausted):
# FORCE_LOCAL_EMBEDDINGS=true
# FORCE_LOCAL_LLM=true

# --- Instagram setup (required for live IG scraping in 2025) ----------------
# IG blocks ALL anonymous GraphQL calls. Pick ONE of the two options below:
#
# Option A (easiest): auto-extract cookies from a browser where you're
# already logged into instagram.com. yt-dlp does the rest. Value is the
# browser name: chrome, edge, firefox, brave, opera, chromium, vivaldi, safari
# IG_BROWSER=chrome
#
# Option B (if Option A is unavailable): export a Netscape cookies.txt
# using a "Get cookies.txt LOCALLY" extension and point to the file.
# IG_COOKIE_FILE=./ig_cookies.txt
#
# If neither is set, the app falls back to a clear error + the
# MANUAL_B_JSON override (recommended for demos).

# Manual overrides (JSON files) for cases where scraping is blocked. Each
# file must contain {"meta": {...}, "transcript": "..."} and matches the
# VideoMetadata schema in app/schemas/models.py. Useful for demos and CI.
# MANUAL_A_JSON=./sample_data/video_a.json
# MANUAL_B_JSON=./sample_data/video_b.json
